# Default: production mode against the real IRD e-Services backend.
# Submitting creates a REAL TIN registration at IRD.
# Override per run, e.g.:  VITE_API_MODE=mock npm run dev      (demo, nothing sent)
#                          VITE_LEGACY_FINAL=false npm run dev  (live dry run, IRD validates only)
VITE_API_MODE=legacy
VITE_LEGACY_FINAL=true
LEGACY_ORIGIN=https://eservices.ird.gov.lk
